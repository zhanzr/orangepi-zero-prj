# Allow members of the "leds" group to control on-board LEDs without root.
# Applies at every LED device add (boot/coldplug).
ACTION=="add", SUBSYSTEM=="leds", RUN+="/bin/chgrp -f leds /sys/class/leds/%k/brightness", RUN+="/bin/chmod -f g+w /sys/class/leds/%k/brightness", RUN+="/bin/chgrp -f leds /sys/class/leds/%k/trigger", RUN+="/bin/chmod -f g+w /sys/class/leds/%k/trigger"
